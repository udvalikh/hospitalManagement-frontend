import { useEffect, useState } from "react";

function DoctorDashboard() {
  const [appointments, setAppointments] = useState([]);
  const [availableDays, setAvailableDays] = useState([]);
  const [availableTimes, setAvailableTimes] = useState([]);

  // Fetch doctor appointments
  useEffect(() => {
    fetch("http://localhost:8080/doctor/appointments")
      .then((response) => response.json())
      .then((data) => setAppointments(data))
      .catch((error) => console.error("Error:", error));
  }, []);

  const handleAvailabilitySubmit = () => {
    const availability = {
      availableDays,
      availableTimes,
    };

    fetch("http://localhost:8080/doctor/availability", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify(availability),
    })
      .then(() => alert("Availability updated"))
      .catch((error) => console.error(error));
  };

  return (
    <div className="p-6">
      <h1 className="text-2xl font-bold text-blue-700 mb-6">
        Doctor Dashboard
      </h1>

      {/* Appointments Section */}
      <div className="mb-8">
        <h2 className="text-xl font-semibold mb-4">Appointments</h2>

        {appointments.length === 0 ? (
          <p>No appointments</p>
        ) : (
          <ul className="space-y-3">
            {appointments.map((appt) => (
              <li
                key={appt.id}
                className="bg-white shadow p-4 rounded-lg"
              >
                <p><strong>Patient:</strong> {appt.patientName}</p>
                <p><strong>Date:</strong> {appt.date}</p>
                <p><strong>Time:</strong> {appt.time}</p>
              </li>
            ))}
          </ul>
        )}
      </div>

      {/* Availability Section */}
      <div className="bg-white shadow p-6 rounded-lg w-96">
        <h2 className="text-xl font-semibold mb-4">
          Set Availability
        </h2>

        <input
          type="text"
          placeholder="Available Days (e.g. Mon,Tue)"
          className="border p-2 w-full mb-3"
          onChange={(e) =>
            setAvailableDays(e.target.value.split(","))
          }
        />

        <input
          type="text"
          placeholder="Available Times (e.g. 9AM-12PM)"
          className="border p-2 w-full mb-3"
          onChange={(e) =>
            setAvailableTimes(e.target.value.split(","))
          }
        />

        <button
          onClick={handleAvailabilitySubmit}
          className="bg-blue-600 text-white px-4 py-2 rounded"
        >
          Save
        </button>
      </div>
    </div>
  );
}

export default DoctorDashboard;